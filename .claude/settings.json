{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(./scripts/vercel.sh:*)",
      "mcp__supabase-prod-ro__*"
    ],
    "ask": [
      "mcp__supabase-prod-rw__*",
      "Bash(supabase db push:*)",
      "Bash(npx supabase db push:*)",
      "Bash(supabase migration repair:*)",
      "Bash(npx supabase migration repair:*)",
      "Bash(supabase secrets set:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run test:db:*)",
      "Bash(npm run test:app:*)",
      "Bash(npm run test:integration:*)",
      "Bash(npm run test:e2e:*)",
      "Bash(npm run worker:run:*)",
      "Bash(npm run pipeline:process:*)",
      "Bash(npm run matching:run:*)",
      "Bash(npm run enrichment:run:*)",
      "Bash(npm run data:import:*)",
      "Bash(npm run concerts:import:*)",
      "Bash(npm run reses:import:*)",
      "Bash(npm run catalog:import:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git branch -m:*)",
      "Bash(git worktree add:*)",
      "Bash(rm -rf:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(supabase start:*)",
      "Bash(supabase stop:*)",
      "Bash(supabase db reset:*)",
      "Bash(supabase projects delete:*)",
      "Bash(supabase unlink:*)",
      "Bash(supabase branches:*)",
      "Bash(npx supabase start:*)",
      "Bash(npx supabase stop:*)",
      "Bash(npx supabase db reset:*)",
      "mcp__supabase-prod-rw__create_branch",
      "mcp__supabase-prod-rw__delete_branch",
      "mcp__supabase-prod-rw__merge_branch",
      "mcp__supabase-prod-rw__reset_branch",
      "mcp__supabase-prod-rw__rebase_branch",
      "mcp__supabase-prod-rw__pause_project",
      "mcp__supabase-prod-rw__restore_project",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(bunx vercel:*)",
      "Bash(pnpm vercel:*)",
      "Bash(pnpm dlx vercel:*)",
      "Bash(./scripts/vercel.sh deploy:*)",
      "Bash(./scripts/vercel.sh link:*)",
      "Bash(./scripts/vercel.sh teams:*)",
      "Bash(./scripts/vercel.sh git:*)",
      "Bash(./scripts/vercel.sh login:*)",
      "Bash(./scripts/vercel.sh logout:*)",
      "Bash(./scripts/vercel.sh switch:*)",
      "mcp__claude_ai_Vercel__*",
      "Edit(./.claude/vercel-identity)",
      "Edit(./.githooks/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./scripts/mcp-supabase.sh)",
      "Bash(git config user.email:*)",
      "Bash(git config --local user.email:*)",
      "Bash(git config --global user.email:*)",
      "Bash(git config --unset user.email:*)",
      "Bash(git config --replace-all user.email:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git config --local core.hooksPath:*)",
      "Bash(git config --unset core.hooksPath:*)",
      "Bash(git -c:*)",
      "Bash(git commit --author:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git push --no-verify:*)",
      "Bash(GIT_AUTHOR_EMAIL=*)",
      "Bash(GIT_COMMITTER_EMAIL=*)"
    ]
  },
  "enabledMcpjsonServers": ["supabase-prod-ro", "supabase-prod-rw"],
  "sandbox": {
    "excludedCommands": ["gh *", "./scripts/vercel.sh *"]
  },
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  }
}
