# Aplicación local contra el Supabase remoto del proyecto. Docker no es necesario.
# npm run dev comprueba el destino y desactiva los workers locales.
NEXT_PUBLIC_SUPABASE_URL=https://vvzxlevbfjvzygorbpxn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_ACCESS_PASSWORD=

# Vercel Production: permite que la web encole tareas para el worker externo.
WORKER_EXECUTION_MODE=

# Worker y matching local.
OPENAI_API_KEY=
OPENAI_MATCHING_MODEL=
MATCHING_CATALOG_SOURCE=
ALLOW_MASTER_MATCHING=

# Exportación local sobre el archivo Master original.
MASTER_EXCEL_PATH=

# La genera automáticamente `vercel link`; no la configures manualmente.
VERCEL_OIDC_TOKEN=
