{
  "name": "mapeig-cartera-serveis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "data:import": "tsx --env-file=.env.local scripts/import-excels.ts",
    "sources:discover": "tsx --env-file=.env.local scripts/discover-source-urls.ts",
    "sources:sample": "tsx --env-file=.env.local scripts/fetch-source-sample.ts",
    "sources:chunk": "tsx --env-file=.env.local scripts/chunk-evidence.ts",
    "matching:ready": "tsx --env-file=.env.local scripts/check-matching-readiness.ts",
    "matching:run": "tsx --env-file=.env.local scripts/run-matching.ts",
    "matching:regenerate-explanations": "tsx --env-file=.env.local scripts/regenerate-matching-explanations.ts",
    "enrichment:run": "tsx --env-file=.env.local scripts/run-enrichment.ts",
    "pipeline:prepare": "tsx --env-file=.env.local scripts/prepare-batch.ts",
    "worker:run": "tsx --env-file=.env.local scripts/run-worker.ts",
    "concerts:discover": "tsx --env-file=.env.local scripts/discover-concerts.ts",
    "concerts:import": "tsx --env-file=.env.local scripts/discover-concerts.ts --import",
    "reses:discover": "tsx --env-file=.env.local scripts/sync-reses.ts",
    "reses:import": "tsx --env-file=.env.local scripts/sync-reses.ts --import"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.109.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "^1.38.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5"
  }
}
